# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time: rebuild after changing.

# Base URL of the hosted Zenkyra FastAPI backend, no trailing slash
# (e.g. https://api.example.com). When set, the demo/pilot dialog POSTs to
# ${NEXT_PUBLIC_API_URL}/api/v1/leads. The backend must allow this site's origin (CORS).
NEXT_PUBLIC_API_URL=

# Sales inbox used only when NEXT_PUBLIC_API_URL is empty: the dialog opens a prefilled
# mailto: and tells the visitor to send it. If both are empty, the dialog shows
# "Booking is not open yet" and submit is disabled.
NEXT_PUBLIC_SALES_EMAIL=
