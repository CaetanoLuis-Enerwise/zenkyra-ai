# Copy to `.env` and fill secrets.
APP_ENV=development
DEBUG=false

# JWT — minimum 32 chars
SECRET_KEY=change-me-use-openssl-rand-hex-32-in-production-min-32chars

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://zenkyra:zenkyra@localhost:5432/zenkyra

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google Gemini (required)
GEMINI_API_KEY=
# Current models per ai.google.dev/gemini-api/docs/models (checked 2026-10-17)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
# Embedding output_dimensionality AND Qdrant vector size (128-3072; changing it = re-index)
GEMINI_EMBEDDING_DIM=768
LLM_PROVIDER=gemini

# Dev convenience — auto-create tables (disable in production; use Alembic)
DATABASE_BOOTSTRAP=true

# Local file storage for uploads
STORAGE_PATH=./storage

# Browser origins allowed by CORS (comma-separated), e.g. https://zenkyra-ai.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:3000

# Service-to-service provisioning (Aegis checkout -> POST /api/v1/admin/tenants).
# Leave empty to disable (503). Generate with: openssl rand -hex 32
ZENKYRA_SERVICE_TOKEN=
# Must point at the frontend /set-password page (it reads ?token=...)
PASSWORD_SET_URL_BASE=http://localhost:3000/set-password
PASSWORD_SET_TOKEN_TTL_HOURS=72
PILOT_DURATION_DAYS=14

# Public self-serve POST /api/v1/auth/signup (403 when false). Keep false outside local dev.
PUBLIC_SIGNUP_ENABLED=false

# Public lead form POST /api/v1/leads: per-IP limit, in-process memory only (per worker, resets on restart)
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=600

# Tell a person when a demo/pilot request is stored. With neither destination set, the row is
# kept and notify_status=skipped (nobody is told). Set at least one before the form is public.
# Email: Reply-To is the prospect. SMTP_PASSWORD is a secret; leave it empty here.
LEADS_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional HTTP POST of the lead. json = structured body; slack = {"text": "..."} for an
# incoming webhook. LEADS_WEBHOOK_SECRET (if set) is sent as X-Zenkyra-Signature: sha256=<hmac of the raw body>.
# The URL must be https, with no user:password@ in it. Do not put a token in the URL.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
LEADS_WEBHOOK_FORMAT=json
LEADS_NOTIFY_TIMEOUT_SECONDS=10
